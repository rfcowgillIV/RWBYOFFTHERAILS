<%# 2026 update: `local: true` was dropped - forms are regular (non-AJAX) by default in Rails 7+. %>
<%= form_with model: @article do |form| %>

  <% if @article.errors.any? %>
    <div id="error_explanation">
      <h2>
        <%= pluralize(@article.errors.count, "error") %> prohibited
        this article from being saved:
      </h2>
      <ul>
        <% @article.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <p>
    <%= form.label :title %><br>
    <%= form.text_field :title, required: true, minlength: 5, maxlength: 200 %>
  </p>

  <p>
    <%= form.label :text %><br>
    <%= form.text_area :text, maxlength: 20000 %>
  </p>

  <p>
    <%= form.submit %>
  </p>

<% end %>
