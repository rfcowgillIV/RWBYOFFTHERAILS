<% content_for :title, "The Vault | RWBY Off The Rails" %>
<% content_for :body_class, "vault" %>

<h1>WELCOME TO The vault!</h1>

<%# SECURITY UPDATE (2026): the login used to be printed here for the whole internet.
    Now it only appears when the app is running on your own computer with the demo
    login. On a real server, set BLOG_EDITOR_NAME / BLOG_EDITOR_PASSWORD and this
    page keeps the secret, like a proper Schnee vault. %>
<% if (hint = editor_login_hint) %>
  <h2>In order to create a new article you're going to need the username and password</h2>
  <h2>username: <%= hint[:name] %></h2>
  <h2>password: <%= hint[:password] %></h2>
  <h2>We appreciate our users complying...</h2>
<% else %>
  <h2>The vault is sealed. Editors: ask the site owner for the login.</h2>
<% end %>
<h2>The Schnee Dust Company!</h2>

<%= link_to "Home Page", root_path %>
<%= link_to "Enter The Fray!", articles_path %>
<%= link_to "New article", new_article_path %>
<%= link_to "The Vault", passwords_path %>
